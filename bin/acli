#!/usr/bin/env bash
# acli - Multi-profile launcher for AI development tools
# Supports: Antigravity CLI (agy), OpenCode, Antigravity IDE, Claude Code, Codex CLI
#
# GitHub: https://github.com/danielorlando97/acli
# License: MIT

set -e

ACLI_VERSION="0.2.0"
ACLI_BASE="${ACLI_BASE:-$HOME/.acli/profiles}"

usage() {
  cat <<'EOF'
acli - Multi-profile launcher for AI development tools

Usage:
  acli <tool> <profile> [arguments...]
  acli create <profile>
  acli list
  acli path <profile>
  acli delete <profile>
  acli version
  acli help

Available tools:
  agy | cli          Antigravity CLI (agy)       → isolates ~/.gemini/antigravity-cli
  opencode | oc      OpenCode                    → isolates XDG_CONFIG/DATA/CACHE dirs
  ide | app          Antigravity Desktop IDE      → isolates --user-data-dir
  claude | cc        Claude Code (claude)         → isolates CLAUDE_CONFIG_DIR
  codex              Codex CLI (codex)            → isolates CODEX_HOME

Commands:
  create <profile>   Create/initialize a new profile explicitly
  list               List all existing profiles and their status
  path <profile>     Print the directory path for a profile
  delete <profile>   Remove a profile and all its isolated data
  version            Print the current acli version
  help               Show this help message

Environment Variables:
  ACLI_BASE          Override the base directory for profiles (default: ~/.acli/profiles)

Examples:
  acli create work-empresa1
  acli agy work-empresa1
  acli agy work-empresa1 --continue
  acli opencode work-empresa2 providers auth
  acli opencode work-empresa2
  acli ide work-empresa3 .
  acli claude work-empresa4
  acli codex work-empresa5
  acli list
  acli delete old-client

For more info: https://github.com/danielorlando97/acli
EOF
}

init_profile() {
  local profile="$1"
  local pdir="$ACLI_BASE/$profile"

  mkdir -p "$pdir/home"
  mkdir -p "$pdir/opencode/config"
  mkdir -p "$pdir/opencode/data"
  mkdir -p "$pdir/opencode/cache"
  mkdir -p "$pdir/antigravity-ide"
  mkdir -p "$pdir/claude"
  mkdir -p "$pdir/codex"

  # Symlink SSH so git/ssh tools work normally inside isolated HOME
  if [ ! -e "$pdir/home/.ssh" ] && [ -d "$HOME/.ssh" ]; then
    ln -s "$HOME/.ssh" "$pdir/home/.ssh" 2>/dev/null || true
  fi
  # Copy gitconfig as a base so the user can customize per-profile
  if [ ! -e "$pdir/home/.gitconfig" ] && [ -f "$HOME/.gitconfig" ]; then
    cp "$HOME/.gitconfig" "$pdir/home/.gitconfig" 2>/dev/null || true
  fi
}

list_profiles() {
  echo "Profiles directory: $ACLI_BASE"
  if [ ! -d "$ACLI_BASE" ] || [ -z "$(ls -A "$ACLI_BASE" 2>/dev/null)" ]; then
    echo "No profiles found yet."
    echo "Create one with: acli create <profile-name>"
    return 0
  fi

  printf "\n%-20s %-12s %-12s %-12s %-12s %-12s\n" "PROFILE" "AGY" "OPENCODE" "IDE" "CLAUDE" "CODEX"
  printf "%-20s %-12s %-12s %-12s %-12s %-12s\n" "-------" "---" "--------" "---" "------" "-----"

  for d in "$ACLI_BASE"/*; do
    [ -d "$d" ] || continue
    local name
    name=$(basename "$d")

    local agy_s="-" oc_s="-" ide_s="-" claude_s="-" codex_s="-"

    [ -d "$d/home/.gemini/antigravity-cli" ]                     && agy_s="✓"
    { [ -f "$d/opencode/data/opencode/auth.json" ] ||
      [ -f "$d/opencode/config/opencode/opencode.json" ]; }       && oc_s="✓"
    [ -n "$(ls -A "$d/antigravity-ide" 2>/dev/null)" ]           && ide_s="✓"
    { [ -f "$d/claude/.claude.json" ] ||
      [ -f "$d/claude/settings.json" ]; }                         && claude_s="✓"
    { [ -f "$d/codex/auth.json" ] ||
      [ -f "$d/codex/config.toml" ]; }                            && codex_s="✓"

    printf "%-20s %-12s %-12s %-12s %-12s %-12s\n" \
      "$name" "$agy_s" "$oc_s" "$ide_s" "$claude_s" "$codex_s"
  done
  echo ""
}

TOOL="${1:-help}"
shift 2>/dev/null || true

case "$TOOL" in
  help | -h | --help)
    usage
    exit 0
    ;;
  version | -v | --version)
    echo "acli v$ACLI_VERSION"
    exit 0
    ;;
  list | profiles | ls)
    list_profiles
    exit 0
    ;;
  create | new | init)
    PROFILE="$1"
    if [ -z "$PROFILE" ]; then
      echo "Error: Missing profile name."
      echo "Usage: acli create <profile>"
      exit 1
    fi
    if [[ "$PROFILE" =~ ^- ]]; then
      echo "Error: Profile name cannot start with '-'."
      exit 1
    fi
    if [ -d "$ACLI_BASE/$PROFILE" ]; then
      echo "Profile '$PROFILE' already exists at $ACLI_BASE/$PROFILE"
      exit 0
    fi
    init_profile "$PROFILE"
    echo "✓ Profile '$PROFILE' created at $ACLI_BASE/$PROFILE"
    echo ""
    echo "Next steps (login per tool):"
    echo "  acli agy     $PROFILE                    # Antigravity CLI"
    echo "  acli opencode $PROFILE providers auth     # OpenCode"
    echo "  acli ide     $PROFILE .                  # Antigravity IDE"
    echo "  acli claude  $PROFILE                    # Claude Code"
    echo "  acli codex   $PROFILE login               # Codex CLI"
    exit 0
    ;;
  delete | rm | remove)
    PROFILE="$1"
    if [ -z "$PROFILE" ]; then
      echo "Error: Missing profile name to delete."
      echo "Usage: acli delete <profile>"
      exit 1
    fi
    PDIR="$ACLI_BASE/$PROFILE"
    if [ ! -d "$PDIR" ]; then
      echo "Error: Profile '$PROFILE' does not exist."
      exit 1
    fi
    printf "Are you sure you want to delete profile '%s' and all its data? [y/N] " "$PROFILE"
    read -r CONFIRM
    if [[ "$CONFIRM" =~ ^[Yy]$ ]]; then
      rm -rf "$PDIR"
      echo "✓ Profile '$PROFILE' has been deleted."
    else
      echo "Cancelled."
    fi
    exit 0
    ;;
  path)
    PROFILE="$1"
    if [ -z "$PROFILE" ]; then
      echo "Error: Missing profile name."
      echo "Usage: acli path <profile>"
      exit 1
    fi
    echo "$ACLI_BASE/$PROFILE"
    exit 0
    ;;
esac

# --- Tool launcher ---

PROFILE="$1"
shift 2>/dev/null || true

if [ -z "$PROFILE" ]; then
  echo "Error: Missing profile name for tool '$TOOL'."
  echo ""
  usage
  exit 1
fi

if [[ "$PROFILE" =~ ^- ]]; then
  echo "Error: Expected a profile name but got option '$PROFILE'."
  echo "Syntax: acli $TOOL <profile> [args...]"
  exit 1
fi

init_profile "$PROFILE"
PDIR="$ACLI_BASE/$PROFILE"

case "$TOOL" in
  agy | cli)
    if ! command -v agy &>/dev/null; then
      echo "Error: 'agy' is not installed or not in PATH."
      echo "Install it from: https://antigravity.google"
      exit 1
    fi
    # Isolate HOME → owns ~/.gemini/antigravity-cli
    export HOME="$PDIR/home"
    exec agy "$@"
    ;;

  opencode | oc)
    if ! command -v opencode &>/dev/null; then
      echo "Error: 'opencode' is not installed or not in PATH."
      echo "Install it from: https://opencode.ai"
      exit 1
    fi
    # OpenCode respects XDG base dirs
    export XDG_CONFIG_HOME="$PDIR/opencode/config"
    export XDG_DATA_HOME="$PDIR/opencode/data"
    export XDG_CACHE_HOME="$PDIR/opencode/cache"
    exec opencode "$@"
    ;;

  ide | app | antigravity)
    if [ ! -d "/Applications/Antigravity.app" ]; then
      echo "Error: Antigravity IDE not found at /Applications/Antigravity.app"
      echo "Download it from: https://antigravity.google"
      exit 1
    fi
    IDE_DATA="$PDIR/antigravity-ide"
    TARGET="${1:-.}"
    [ -n "$1" ] && shift
    open -n -a "/Applications/Antigravity.app" --args \
      --user-data-dir "$IDE_DATA" \
      "$TARGET" "$@"
    ;;

  claude | cc | claude-code)
    if ! command -v claude &>/dev/null; then
      echo "Error: 'claude' is not installed or not in PATH."
      echo "Install it from: https://claude.ai/download"
      exit 1
    fi
    # Claude Code uses CLAUDE_CONFIG_DIR for all credentials and settings
    export CLAUDE_CONFIG_DIR="$PDIR/claude"
    exec claude "$@"
    ;;

  codex)
    if ! command -v codex &>/dev/null; then
      echo "Error: 'codex' is not installed or not in PATH."
      echo "Install it from: https://github.com/openai/codex"
      exit 1
    fi
    # Codex uses CODEX_HOME for auth, config and sessions
    export CODEX_HOME="$PDIR/codex"
    exec codex "$@"
    ;;

  *)
    echo "Error: Unknown tool '$TOOL'."
    echo ""
    usage
    exit 1
    ;;
esac
